#!/usr/bin/env bash
# Login message of a vps-apps server, run by pam_motd as /etc/update-motd.d/99-vps-apps.
# It reads the app, the host and the n8n owner email from the settings install.sh records (as data;
# the bootstrap's env file on a server installed before those existed) and the install status,
# nothing else. Every value is printed only when it has the expected shape.
# set -e is deliberately off: a login must never fail because of this message.
R="${VPS_APPS_ROOT:-}"

app="" host="" email=""
env_file="$R/etc/vps-apps/app.env"
[ -r "$env_file" ] || env_file="$R/etc/vps-apps/env"
if [ -r "$env_file" ]; then
  while IFS='=' read -r key value || [ -n "$key" ]; do
    case "$key" in
      APP) app="$value" ;;
      VA_HOST) host="$value" ;;
      ADMIN_EMAIL) email="$value" ;;
    esac
  done <"$env_file"
fi
[[ "$host" =~ ^[A-Za-z0-9.-]+$ ]] || host=""
# The rule of valid_email in lib/common.sh.
email_re='^[a-z0-9_%+-]+(\.[a-z0-9_%+-]+)*@([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$'
if [ "$app" != n8n ] || [ "${#email}" -gt 254 ] || ! [[ "$email" =~ $email_re ]]; then
  email=""
fi

status=""
status_file="$R/var/lib/vps-apps/public/.well-known/rarecloud-app-status"
if [ -r "$status_file" ]; then
  status="$(head -c 64 "$status_file" 2>/dev/null || true)"
fi
case "$status" in
  installing | ready) ;;
  failed:[a-z0-9_-]*) [[ "$status" =~ ^failed:[a-z0-9_-]+$ ]] || status="" ;;
  *) status="" ;;
esac
[ -n "$status" ] || status="unknown"

echo
echo "RareCloud app server"
if [ -n "$host" ]; then
  echo "  Open: https://$host"
fi
echo "  Status: $status"
if [ -f "$R/root/vps-apps-credentials.txt" ]; then
  echo "  The password you set does not meet the app's password rules: the generated login is in /root/vps-apps-credentials.txt"
elif [ -n "$email" ]; then
  echo "  Login: $email, with the password you set when you ordered this server. 'rc status' shows the details."
elif [ "$app" = nextcloud ] || [ "$app" = uptimekuma ]; then
  echo "  Login: admin, with the password you set when you ordered this server."
elif [ "$app" = wordpress ] && [ -n "$host" ]; then
  echo "  Login: https://$host/wp-admin/ as admin, with the password you set when you ordered this server."
elif [ "$app" = forgejo ]; then
  echo "  Login: gitadmin, with the password you set when you ordered this server. Git over SSH: port 2222."
else
  echo "  Login: use the password you set when you ordered this server. 'rc status' shows the details."
fi
echo
