[Unit]
Description=vps-apps host firewall (nftables table vps_apps)
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
After=local-fs.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/vps-apps/vps-apps.nft
ExecReload=/usr/sbin/nft -f /etc/vps-apps/vps-apps.nft

[Install]
WantedBy=sysinit.target
