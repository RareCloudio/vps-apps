[Unit]
Description=vps-apps on-link flag for an IPv6 gateway outside the VPS prefix, before networkd reads netplan's output
# systemd's netplan generator has run from the netplan files before any unit; the runner fixes them
# and generates /run/systemd/network again before networkd starts.
DefaultDependencies=no
After=local-fs.target
Before=systemd-networkd.service network-pre.target shutdown.target
Wants=network-pre.target
Conflicts=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/vps-apps-ipv6-onlink
# A oneshot has no start timeout by default; networkd waits for this one.
TimeoutStartSec=60

[Install]
WantedBy=systemd-networkd.service
