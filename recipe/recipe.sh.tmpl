# shellcheck shell=sh
# First-boot recipe run once by the Virtualizor panel (POSIX sh, run by dash).
# It only leaves files and a systemd timer behind. The timer-driven bootstrap later
# downloads one pinned commit of this repo and runs install.sh. Nothing here needs
# the internet, and nothing here prints the password (the recipe log is world-readable).
# bin/render-recipe fills in the app, mode and version; the panel fills in the
# Virtualizor tokens at provisioning. Panel values only ever sit in QUOTED heredocs,
# so no character in them is interpreted by this shell.
set -eu
umask 077

R="${VPS_APPS_ROOT:-}"

mkdir -p "$R/etc/vps-apps" "$R/var/lib/vps-apps" "$R/usr/local/sbin" "$R/etc/systemd/system"

VA_IP="$(ip -4 route get 1.1.1.1 | sed -n 's/.* src \([0-9.][0-9.]*\).*/\1/p' | head -n 1)"

cat >"$R/etc/vps-apps/env" <<'ENV_END'
APP=__APP__
MODE=__MODE__
VERSION=__VERSION__
ENV_END
# The panel values come last. A hostname or an email with an embedded newline makes the env file
# invalid, and the bootstrap then ends with failed:args. At provisioning the panel's username token
# holds the customer's email, which becomes the n8n owner login or the WordPress admin email (the
# bootstrap passes it on only when it is a plain address). A panel token never goes in a comment: the panel fills those in too,
# and a newline in the value would end the comment.
{
  printf 'VA_IP=%s\n' "$VA_IP"
  cat <<'VPS_APPS_HOST_END_7f3a'
VA_HOST={{vps_hostname}}
VPS_APPS_HOST_END_7f3a
  cat <<'VPS_APPS_EMAIL_END_7f3a'
ADMIN_EMAIL={{username}}
VPS_APPS_EMAIL_END_7f3a
} >>"$R/etc/vps-apps/env"

# The password comes from a quoted heredoc, so no character in it is interpreted.
# The heredoc adds one trailing newline, which is removed again.
cat >"$R/etc/vps-apps/password" <<'VPS_APPS_PW_END_7f3a'
{{root_pass}}
VPS_APPS_PW_END_7f3a
truncate -s -1 "$R/etc/vps-apps/password"
chmod 0600 "$R/etc/vps-apps/password"

cat >"$R/usr/local/sbin/vps-apps-bootstrap" <<'VPS_APPS_BOOTSTRAP_END_7f3a'
#!/usr/bin/env bash
# Runs from vps-apps-install.timer every 60 seconds until the install is ready or the
# budget (45 minutes or 30 attempts) is spent. Self-contained until the tarball is extracted.
set -euo pipefail
umask 077

R="${VPS_APPS_ROOT:-}"
ENV_FILE="$R/etc/vps-apps/env"
PW_FILE="$R/etc/vps-apps/password"
STATE="$R/var/lib/vps-apps"
# install.sh's own copy of the password; it removes it when it exits, unless it was killed.
PW_COPY="$STATE/.admin-password"
STATUS_DIR="$STATE/public/.well-known"
STATUS_FILE="$STATUS_DIR/rarecloud-app-status"
FIRST="$STATE/first-attempt"
ATTEMPTS="$STATE/attempts"
LAST_FAILURE="$STATE/last-failure"
MAX_ATTEMPTS=30
MAX_SECONDS=2700
TIMER=vps-apps-install.timer

current_status() { cat "$STATUS_FILE" 2>/dev/null || true; }

# write_status <value>: atomic replace, same shape as lib/steps.sh set_status.
write_status() {
  local tmp
  mkdir -p "$STATUS_DIR"
  tmp="$(mktemp "$STATE/.status.XXXXXX")"
  printf '%s' "$1" >"$tmp"
  chmod 0644 "$tmp"
  mv -f "$tmp" "$STATUS_FILE"
}

# Reserved bootstrap reasons: download, args, os, timeout, install. They are owned by this
# script and may be overwritten by a later one. install.sh steps must never use them as
# step names: any other failed:<step> comes from install.sh and is kept.
# mark_failed <reason>: writes failed:<reason> unless the status is ready or a failed:<step>
# written by install.sh. A failed write must never stop finish (it shreds the password).
mark_failed() {
  case "$(current_status)" in
    ready) return 0 ;;
    failed:download | failed:args | failed:os | failed:timeout | failed:install) ;;
    failed:*) return 0 ;;
  esac
  write_status "failed:$1" || true
}

# finish: the timer is switched off and the password (and install.sh's copy of it) is destroyed.
finish() {
  local f
  for f in "$PW_FILE" "$PW_COPY"; do
    if [ -e "$f" ]; then shred -u "$f" 2>/dev/null || rm -f "$f"; fi
  done
  systemctl disable --now "$TIMER" || true
}

# site_failed: best effort, the HTTPS page then says the install failed instead of "being set up"
# forever. install.sh decides from the site mode and never touches a server in app mode. Nothing
# here may stop finish (it shreds the password).
site_failed() {
  local inst="$R/opt/vps-apps/current/install.sh"
  [ -x "$inst" ] || return 0
  (
    umask 022
    timeout 60 "$inst" --site-failed
  ) || echo "vps-apps-bootstrap: could not switch the page to failed" >&2
}

finish_failed() {
  mark_failed "$1"
  site_failed || true
  finish
}

attempts_made() {
  local n=0
  if [ -f "$ATTEMPTS" ]; then n="$(cat "$ATTEMPTS")"; fi
  echo "$n"
}

seconds_left() {
  local first now
  if [ ! -f "$FIRST" ]; then
    echo "$MAX_SECONDS"
    return 0
  fi
  first="$(cat "$FIRST")"
  now="$(date +%s)"
  echo $((MAX_SECONDS - (now - first)))
}

budget_spent() {
  [ "$(attempts_made)" -ge "$MAX_ATTEMPTS" ] && return 0
  [ "$(seconds_left)" -le 0 ] && return 0
  return 1
}

last_reason() { cat "$LAST_FAILURE" 2>/dev/null || echo timeout; }

# retry_later <reason>: this attempt failed. The timer runs again unless the budget is spent.
retry_later() {
  echo "$1" >"$LAST_FAILURE" || true
  if budget_spent; then finish_failed "$1"; fi
  exit 0
}

# ready is checked first: it must never be overwritten, and the password is destroyed.
if [ "$(current_status)" = ready ]; then
  finish
  exit 0
fi

# The env file is only trusted after it is checked: five known keys and the optional ADMIN_EMAIL,
# each once, and VERSION pinned to a commit. A missing file is final too: a failed redirect would
# kill this script before any attempt is counted, and the timer would run it forever.
bad_env() {
  echo "vps-apps-bootstrap: $ENV_FILE: $1" >&2
  finish_failed args
  exit 2
}
if [ ! -f "$ENV_FILE" ] || [ ! -r "$ENV_FILE" ]; then bad_env "missing or unreadable"; fi
APP="" MODE="" VERSION="" VA_HOST="" VA_IP="" ADMIN_EMAIL=""
seen=" "
while IFS='=' read -r key value; do
  case "$seen" in *" $key "*) bad_env "repeated key $key" ;; esac
  seen="$seen$key "
  case "$key" in
    APP) APP="$value" ;;
    MODE) MODE="$value" ;;
    VERSION) VERSION="$value" ;;
    VA_HOST) VA_HOST="$value" ;;
    VA_IP) VA_IP="$value" ;;
    ADMIN_EMAIL) ADMIN_EMAIL="$value" ;;
    *) bad_env "unknown line" ;;
  esac
done <"$ENV_FILE"
case "$APP" in docker | n8n | nextcloud | forgejo | wordpress | uptimekuma | grafana) ;; *) bad_env "bad APP" ;; esac
case "$MODE" in "" | starter | pro) ;; *) bad_env "bad MODE" ;; esac
[[ "$VERSION" =~ ^[0-9a-f]{40}$ ]] || bad_env "VERSION is not a 40 character commit"
[[ "$VA_HOST" =~ ^[A-Za-z0-9.-]+$ ]] || bad_env "VA_HOST has characters outside A-Za-z0-9.-"
VA_HOST="${VA_HOST,,}"
# The owner email is optional and never fatal: anything but a plain address (the rule of valid_email
# in lib/common.sh) is dropped, and install.sh then uses admin@<host>. The value is not printed.
ADMIN_EMAIL="${ADMIN_EMAIL,,}"
email_re='^[a-z0-9_%+-]+(\.[a-z0-9_%+-]+)*@([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$'
email_local="${ADMIN_EMAIL%@*}"
if [ -n "$ADMIN_EMAIL" ] &&
  ! { [ "${#ADMIN_EMAIL}" -le 254 ] && [ "${#email_local}" -le 64 ] && [[ "$ADMIN_EMAIL" =~ $email_re ]]; }; then
  echo "vps-apps-bootstrap: ADMIN_EMAIL is not a plain address, the owner login will be admin@$VA_HOST" >&2
  ADMIN_EMAIL=""
fi

if budget_spent; then
  finish_failed "$(last_reason)"
  exit 0
fi

mkdir -p "$STATE"
if [ ! -f "$FIRST" ]; then date +%s >"$FIRST"; fi
echo $(($(attempts_made) + 1)) >"$ATTEMPTS"

octet='(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])'
ip_re="^${octet}(\\.${octet}){3}\$"
if ! [[ "$VA_IP" =~ $ip_re ]]; then
  VA_IP="$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.][0-9.]*\).*/\1/p' | head -n 1)"
  if ! [[ "$VA_IP" =~ $ip_re ]]; then
    echo "vps-apps-bootstrap: no IPv4 address yet" >&2
    retry_later args
  fi
fi

CODE="$R/opt/vps-apps/$VERSION"
if [ ! -x "$CODE/install.sh" ]; then
  mkdir -p "$R/opt/vps-apps"
  work="$(mktemp -d "$R/opt/vps-apps/.dl.XXXXXX")"
  mkdir "$work/src"
  if ! curl -fsSL --retry 2 --max-time 120 -o "$work/src.tar.gz" \
    "https://codeload.github.com/RareCloudio/vps-apps/tar.gz/${VERSION}" ||
    ! tar -xzf "$work/src.tar.gz" -C "$work/src" --strip-components=1; then
    rm -rf "$work"
    mark_failed download
    retry_later download
  fi
  rm -rf "$CODE"
  mv "$work/src" "$CODE"
  rm -rf "$work"
fi
ln -sfn "$CODE" "$R/opt/vps-apps/current"

args=(--app "$APP" --host "$VA_HOST" --ip "$VA_IP" --password-file "$PW_FILE")
[ -z "$MODE" ] || args+=(--mode "$MODE")
[ -z "$ADMIN_EMAIL" ] || args+=(--admin-email "$ADMIN_EMAIL")

# Contract: install.sh runs with umask 022; every secret file it or this script writes
# gets an explicit chmod (the password file is 0600).
umask 022
write_status installing || true
left="$(seconds_left)"
[ "$left" -ge 1 ] || left=1
rc=0
timeout --kill-after=30 "$left" "$R/opt/vps-apps/current/install.sh" "${args[@]}" || rc=$?

case "$rc" in
  0)
    finish
    exit 0
    ;;
  2)
    finish_failed args
    exit 2
    ;;
  3)
    finish_failed os
    exit 3
    ;;
  124 | 137) retry_later timeout ;;
  *) retry_later install ;;
esac
VPS_APPS_BOOTSTRAP_END_7f3a
chmod 0755 "$R/usr/local/sbin/vps-apps-bootstrap"

# No [Install] section on the service: boot never waits on it, the timer starts it.
cat >"$R/etc/systemd/system/vps-apps-install.service" <<'UNIT_END'
[Unit]
Description=RareCloud app installer
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/vps-apps-bootstrap
UNIT_END

cat >"$R/etc/systemd/system/vps-apps-install.timer" <<'UNIT_END'
[Unit]
Description=Run the RareCloud app installer until it is ready

[Timer]
OnBootSec=30
OnUnitInactiveSec=60
AccuracySec=1s

[Install]
WantedBy=timers.target
UNIT_END
chmod 0644 "$R/etc/systemd/system/vps-apps-install.service" "$R/etc/systemd/system/vps-apps-install.timer"

systemctl daemon-reload
systemctl enable --now vps-apps-install.timer
