#!/usr/bin/env bash
# Test stub: logs argv to STUB_TMP/netplan.log. "generate" appends every netplan file under
# VPS_APPS_ROOT to STUB_TMP/netplan.seen (what it validated), then exits with the code in
# STUB_TMP/netplan_rc when that file exists, with an error on stderr like netplan's.
printf '%s\n' "$*" >>"${STUB_TMP:?}/netplan.log"
if [ "${1:-}" = generate ]; then
  cat "${VPS_APPS_ROOT:?}"/etc/netplan/*.yaml >>"$STUB_TMP/netplan.seen" 2>/dev/null || true
fi
if [ -f "$STUB_TMP/netplan_rc" ]; then
  echo "netplan: stub: Error in network definition" >&2
  exit "$(cat "$STUB_TMP/netplan_rc")"
fi
exit 0
