#!/usr/bin/env bash
# Test stub: logs argv. "buildx imagetools inspect <ref>" answers a manifest whose digest is
# derived from the ref; "network inspect" fails when STUB_TMP/no_web_network exists.
printf '%s\n' "$*" >>"${STUB_TMP:?}/docker.log"
case "$1 $2 $3" in
  "buildx imagetools inspect")
    sum="$(printf '%s' "$4" | sha256sum | cut -d' ' -f1)"
    printf '{"mediaType":"application/vnd.oci.image.index.v1+json","digest":"sha256:%s","size":1}\n' "$sum"
    ;;
  "network inspect "*)
    [ -e "$STUB_TMP/no_web_network" ] && exit 1
    ;;
esac
exit 0
