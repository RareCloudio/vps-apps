#!/usr/bin/env bash
# Test stub: logs argv to STUB_TMP/ping.log. No reply (exit 1), as on a VPS whose IPv6 route is
# missing, unless STUB_TMP/ping_rc holds another exit code (0 is a reply).
printf '%s\n' "$*" >>"${STUB_TMP:?}/ping.log"
if [ -f "$STUB_TMP/ping_rc" ]; then exit "$(cat "$STUB_TMP/ping_rc")"; fi
exit 1
