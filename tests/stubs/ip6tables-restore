#!/usr/bin/env bash
# Test stub: logs argv and the loaded file. Failure injection through files in STUB_TMP:
# fail_ip6tables-restore_check (for -t) and fail_ip6tables-restore_load (for a real load).
printf '%s\n' "ip6tables-restore $*" >>"${STUB_TMP:?}/fw.log"
last="${!#}"
if [[ " $* " == *" -t "* ]]; then
  [ -e "$STUB_TMP/fail_ip6tables-restore_check" ] && exit 1
  exit 0
fi
[ -e "$STUB_TMP/fail_ip6tables-restore_load" ] && exit 1
[ -f "$last" ] && cat "$last" >>"$STUB_TMP/ip6tables-restore.in"
exit 0
