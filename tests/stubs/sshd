#!/usr/bin/env bash
# Test stub: logs argv (also into the shared calls.log, to check ordering against systemctl).
# `sshd -t` exits with the code in STUB_TMP/sshd_rc when that file exists.
# `sshd -T` exits with the code in STUB_TMP/sshd_T_rc when that file exists. Otherwise it prints the
# content of STUB_TMP/sshd_T_override when that file exists, or else a stock Ubuntu configuration:
# "passwordauthentication <value>" taken from the drop-in under VPS_APPS_ROOT (when there is one),
# then public key login on, the default AuthorizedKeysFile and AuthenticationMethods, and port 22.
# Lines in STUB_TMP/sshd_T_set replace every stock line with the same keyword.
printf '%s\n' "$*" >>"${STUB_TMP:?}/sshd.log"
printf 'sshd %s\n' "$*" >>"$STUB_TMP/calls.log"
if [ "${1:-}" = "-T" ]; then
  if [ -f "$STUB_TMP/sshd_T_rc" ]; then exit "$(cat "$STUB_TMP/sshd_T_rc")"; fi
  if [ -f "$STUB_TMP/sshd_T_override" ]; then
    cat "$STUB_TMP/sshd_T_override"
    exit 0
  fi
  dropin="${VPS_APPS_ROOT:-}/etc/ssh/sshd_config.d/10-vps-apps.conf"
  set_file="$STUB_TMP/sshd_T_set"
  {
    [ ! -f "$dropin" ] || sed -n 's/^PasswordAuthentication \(.*\)$/passwordauthentication \1/p' "$dropin"
    printf '%s\n' 'pubkeyauthentication yes' 'authorizedkeysfile .ssh/authorized_keys .ssh/authorized_keys2' \
      'authenticationmethods any' 'port 22' 'listenaddress [::]:22' 'listenaddress 0.0.0.0:22'
  } | while read -r key rest; do
    if [ -f "$set_file" ] && awk -v k="$key" '$1 == k { found = 1 } END { exit !found }' "$set_file"; then
      continue
    fi
    printf '%s %s\n' "$key" "$rest"
  done
  [ ! -f "$set_file" ] || cat "$set_file"
  exit 0
fi
if [ -f "$STUB_TMP/sshd_rc" ]; then exit "$(cat "$STUB_TMP/sshd_rc")"; fi
exit 0
