#!/usr/bin/env bash
# Test stub: logs argv; "-C" (rule check) fails when STUB_TMP/fail_ip6tables_C exists; "-S" (list,
# which fails on a kernel booted with ipv6.disable=1) fails when STUB_TMP/fail_ip6tables_S exists.
printf '%s\n' "ip6tables $*" >>"${STUB_TMP:?}/fw.log"
if [[ " $* " == *" -C "* ]] && [ -e "$STUB_TMP/fail_ip6tables_C" ]; then exit 1; fi
if [[ " $* " == *" -S "* ]] && [ -e "$STUB_TMP/fail_ip6tables_S" ]; then exit 1; fi
exit 0
