#!/usr/bin/env bash
# rc: the server's command line. Each subcommand lives in bin/rc.d/<name>.sh as rc_<name>.
set -euo pipefail

RC_ROOT="$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")"
# shellcheck source=/dev/null
. "$RC_ROOT/lib/common.sh"
# shellcheck source=/dev/null
. "$RC_ROOT/base/50-firewall.sh"

rc_usage() {
  {
    echo "usage: rc <command> [...]"
    echo "  rc port open <port>[/tcp|/udp]    open a host or container port"
    echo "  rc port close <port>[/tcp|/udp]   close it again"
    echo "  rc port list                      show the opened ports"
  } >&2
  exit 2
}

# A non-empty VPS_APPS_ROOT is a test root, where root is not needed.
if [ -z "${VPS_APPS_ROOT:-}" ] && [ "$(id -u)" -ne 0 ]; then
  echo "rc: run as root (sudo rc ...)" >&2
  exit 2
fi

cmd="${1:-}"
[[ "$cmd" =~ ^[a-z][a-z0-9-]*$ ]] || rc_usage
[ -f "$RC_ROOT/bin/rc.d/$cmd.sh" ] || rc_usage
shift
# shellcheck source=/dev/null
. "$RC_ROOT/bin/rc.d/$cmd.sh"
"rc_${cmd//-/_}" "$@"
